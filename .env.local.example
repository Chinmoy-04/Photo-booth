# Passphrase for the privacy gate (set in Vercel project env vars for production)
SITE_PASSPHRASE=your-secret-passphrase-here

# Secret used to sign the access cookie (generate a long random string)
SITE_COOKIE_SECRET=change-me-to-a-long-random-string

# LiveKit Cloud — https://cloud.livekit.io (free tier works for a couple session)
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Vercel Blob — create a Blob store in your Vercel project dashboard
BLOB_READ_WRITE_TOKEN=your-vercel-blob-read-write-token
